DATABASE_URL = sqlite:///./app.db
FRONTEND_ORIGIN = http://localhost:5173
GOOGLE_CLIENT_ID = Acquire at: https://console.cloud.google.com/auth
GOOGLE_CLIENT_SECRET = Acquire at: https://console.cloud.google.com/auth
JWT_SECRET = Acquire with: python -c "import secrets; print(secrets.token_hex(32))"
ALLOWED_DOMAINS = @gmail.com, @proton.me
